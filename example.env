# ======================================================
# 🎙️ Twitch TTS Bot - Environment Configuration Example
# Copy this file to `.env` to override default settings
# ======================================================

# Local TTS API Endpoint & Voice Settings
TTS_API_URL=http://192.168.1.3:6969/api/tts
TTS_MODEL=
TTS_VOICE=mieto
TTS_FORMAT=ogg

# Text Processing & Chunking Bounds
MAX_CHUNK_CHARS=50
MIN_CHUNK_CHARS=10

# Web Dashboard Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Twitch Channel & User Voice Customization
TWITCH_CHANNEL=m_e_s_t_a_a_j_a
USER_TEMPLATE={user} sanoo: {text}
VOICE_PRESETS=mieto, terapisti, terry, tuomo4, niilo

# Real Twitch Chat Bot Authentication (Optional)
# Leave blank for anonymous read-only mode (justinfan)
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=

# Real Twitch Chat Interactive Responses & Periodic Tips
ENABLE_CHAT_RESPONSES=true
ENABLE_PERIODIC_INFO=false
PERIODIC_INFO_INTERVAL=15

# Path to JSON config file for Web Dashboard persistence
CONFIG_FILE=config.json
