# Twitch TTS Bot Configuration Example Environment File
# Copy this file to '.env' and edit as needed.

# ==============================================================================
# TTS API Settings (Custom TTS Server)
# ==============================================================================
TTS_API_URL=http://192.168.1.3:6969
TTS_VOICE=voice_fi
TTS_MODEL=
TTS_FORMAT=wav
TTS_LANGUAGE=fi
TTS_SPEED=1.0
TTS_NUM_STEP=32
TTS_GUIDANCE_SCALE=2.0
TTS_SEED=42

# Voice Presets & Shouting Voice Settings
VOICE_PRESETS=voice_fi, mieto, terapisti, terry, tuomo4, niilo
SHOUTING_VOICES=mertaranta_fi

# ==============================================================================
# Web Server Ports
# ==============================================================================
# Admin Dashboard (private, LAN-only recommended)
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Public Server (internet-facing: Control Portal, Voice Player, OBS Overlay)
# Set CONTROL_PASSWORD below to protect the control portal on the public internet!
PUBLIC_SERVER_HOST=0.0.0.0
PUBLIC_SERVER_PORT=5001

# Public site domain / URL for generated OBS overlay links & external access
# (e.g. "tts.example.com", "my-domain.org", or "https://tts.example.com")
SITE_DOMAIN=

# Passwords for web access
ADMIN_PASSWORD=
CONTROL_PASSWORD=

# ==============================================================================
# Twitch Bot & IRC Settings
# ==============================================================================
TWITCH_CHANNEL=m_e_s_t_a_a_j_a
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=
TWITCH_CLIENT_ID=
USER_TEMPLATE={user} sanoo: {text}
SAME_USER_TIMEOUT=10.0
ENABLE_CHAT_RESPONSES=true
ENABLE_PERIODIC_INFO=false
PERIODIC_INFO_INTERVAL=15

# ==============================================================================
# Soundboard & Audio Effects Settings
# ==============================================================================
ENABLE_SOUNDBOARD=true
SOUNDBOARD_DIR=storage/soundboard
EFFECT_8D_SPEED=0.5

# ==============================================================================
# Kill Counter / DarkCounter & Bible API Settings
# ==============================================================================
ENABLE_KILL_COUNTER=true
KILL_COUNTER_FILE=values/deaths
KILL_COUNTER_POLL_INTERVAL=1.0
KILL_COUNTER_VOICE=terapisti
KILL_COUNTER_TEMPLATE=Kuolema {count}. {reference}: {text}
BIBLE_API_URL=https://bible-api.com/?random=verse
KILL_COUNTER_API_TOKEN=
